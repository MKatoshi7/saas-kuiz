generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      String   @default("user") // user, admin

  // Subscription fields
  subscriptionStatus String?   @default("free") // free, active, canceled, expired
  subscriptionPlan   String?   // starter, pro, enterprise
  subscriptionEndsAt DateTime?

  funnels         Funnel[]
  transactions    SubscriptionTransaction[]
  adminActions    AdminAction[]         @relation("AdminActions")
  auditedActions  AdminAction[]         @relation("TargetUser")
  userNotes       AdminNote[]           @relation("TargetUserNotes")
  noteAuthored    AdminNote[]           @relation("AuthorNotes")
  broadcastsSent  Broadcast[]           @relation("BroadcastAuthor")
  couponUses      CouponRedemption[]
  webhookEvents   WebhookEvent[]
  // planMappings created by this admin

  @@map("users")
}

model Funnel {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  customDomain    String?          @unique
  description     String?
  theme           Json?            @default("{\"bgColor\": \"#ffffff\", \"primaryColor\": \"#2563EB\"}")
  themeConfig     Json?
  marketingConfig Json?
  status          String           @default("draft")
  isBanned        Boolean          @default(false)
  banReason       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  userId          String
  steps           FunnelStep[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrations    Integration[]
  sessions        VisitorSession[]
  notes           FunnelNote[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([isBanned])
  @@map("funnels")
}

model FunnelStep {
  id         String            @id @default(cuid())
  funnelId   String
  title      String
  slug       String
  stepType   String            @default("question")
  order      Int
  settings   Json?             @default("{}")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  events     Event[]
  components FunnelComponent[]
  funnel     Funnel            @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, slug])
  @@unique([funnelId, order])
  @@map("funnel_steps")
}

model FunnelComponent {
  id        String     @id @default(cuid())
  stepId    String
  type      String
  order     Int
  data      Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  step      FunnelStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("funnel_components")
}

model VisitorSession {
  id              String    @id @default(cuid())
  funnelId        String
  sessionId       String    @unique
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  referrer        String?
  userAgent       String?
  ipAddress       String?
  country         String?
  deviceType      String?
  browser         String?
  visitorData     Json?     @default("{}")
  answersSnapshot Json?
  isLead          Boolean   @default(false)
  isConverted     Boolean   @default(false)
  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @updatedAt
  completedAt     DateTime?
  email           String?
  name            String?
  phone           String?
  events          Event[]
  funnel          Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId, isLead])
  @@index([email])
  @@index([funnelId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("visitor_sessions")
}

model Event {
  id        String         @id @default(cuid())
  sessionId String
  stepId    String?
  eventType String
  eventName String?
  data      Json?
  createdAt DateTime       @default(now())
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step      FunnelStep?    @relation(fields: [stepId], references: [id])

  @@index([sessionId])
  @@index([stepId])
  @@index([eventType])
  @@index([sessionId, eventType, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("events")
}

model Integration {
  id        String   @id @default(cuid())
  funnelId  String
  type      String
  url       String?
  config    Json?
  trigger   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

model SubscriptionTransaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  status        String
  provider      String
  transactionId String?
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([createdAt(sort: Desc)])
  @@map("subscription_transactions")
}

model WebhookLog {
  id        String   @id @default(cuid())
  provider  String
  eventType String?
  payload   Json
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([createdAt(sort: Desc)])
  @@map("webhook_logs")
}

// Webhooks recebidos de provedores de pagamento (Cakto, Stripe, Hotmart, Kiwify, etc).
// Armazena payload cru + dados parseados + status do processamento.
model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String   // 'cakto' | 'stripe' | 'hotmart' | 'kiwify' | 'unknown'
  eventType       String?  // 'purchase.approved', 'invoice.paid', etc.
  externalId      String?  // ID único do evento no provedor (idempotência)
  source          String   @default("api") // 'api' | 'manual' (colar manualmente)
  // Payload cru (raw)
  rawPayload      Json
  headers         Json?
  // Dados parseados (best-effort)
  parsedData      Json?
  // Identificação do comprador
  customerEmail   String?
  customerName    String?
  customerPhone   String?
  // Identificação do produto
  productId       String?
  productName     String?
  // Valor e moeda
  amount          Float?
  currency        String?  @default("BRL")
  // Plano Kuiz inferido
  kuizPlan        String?  // 'starter' | 'pro' | 'enterprise'
  // Período (em dias) inferido
  periodDays      Int?     @default(30)
  // Processamento
  status          String   @default("pending") // 'pending' | 'processed' | 'failed' | 'ignored' | 'duplicate'
  processedAt     DateTime?
  error           String?
  // Usuário afetado
  affectedUserId  String?
  // Source IP / User Agent (segurança)
  ipAddress       String?
  userAgent       String?
  // Timestamps
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  affectedUser    User?    @relation(fields: [affectedUserId], references: [id], onDelete: SetNull)

  @@index([provider, eventType])
  @@index([customerEmail])
  @@index([externalId])
  @@index([status])
  @@index([receivedAt(sort: Desc)])
  @@map("webhook_events")
}

// Mapeamento de product_id (provedor) → plano Kuiz + periodicidade.
// Admin configura via UI para identificar qual produto é qual plano.
model PlanMapping {
  id              String   @id @default(cuid())
  provider        String   // 'cakto' | 'stripe' | 'hotmart' | 'kiwify' | etc.
  externalProductId String  // product_id que vem do webhook
  externalProductName String?
  kuizPlan        String   // 'starter' | 'pro' | 'enterprise'
  periodDays      Int      @default(30)
  amount          Float?
  currency        String?  @default("BRL")
  isActive        Boolean  @default(true)
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // createdBy relation optional (not enforced)

  @@unique([provider, externalProductId])
  @@index([kuizPlan])
  @@map("plan_mappings")
}

// Config do webhook (secret, etc)
model WebhookConfig {
  id              String   @id @default(cuid())
  provider        String   @unique // 'cakto' | 'stripe' | 'hotmart' | 'kiwify'
  secret          String?  // HMAC secret compartilhado
  isActive        Boolean  @default(true)
  description     String?
  // Eventos aceitos (vazio = todos)
  acceptedEvents  String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("webhook_configs")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   Json?
  stack     String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@map("system_logs")
}

model AdminAction {
  id            String   @id @default(cuid())
  adminId       String
  targetUserId  String?
  targetFunnelId String?
  action        String
  details       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  admin       User  @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser  User? @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("admin_actions")
}

// Notas internas do admin em usuários (visíveis para outros admins)
model AdminNote {
  id          String   @id @default(cuid())
  authorId    String
  targetUserId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author     User @relation("AuthorNotes", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser User @relation("TargetUserNotes", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("admin_notes")
}

// Notas internas do admin em funis
model FunnelNote {
  id        String   @id @default(cuid())
  authorId  String
  funnelId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId, createdAt(sort: Desc)])
  @@map("funnel_notes")
}

// Cupons de desconto para assinatura
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   // percent, fixed
  discountValue   Float
  maxUses         Int?
  usedCount       Int      @default(0)
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  applicablePlans String?  // CSV: "starter,pro,enterprise" ou null = todos
  isActive        Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive, validUntil])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// Broadcasts (mensagens em massa)
model Broadcast {
  id            String    @id @default(cuid())
  authorId      String
  subject       String
  message       String
  // Segmentação: filtros aplicados
  segmentRole       String?  // 'all' | 'user' | 'admin'
  segmentPlan       String?  // 'all' | 'free' | 'starter' | 'pro' | 'enterprise'
  segmentStatus     String?  // 'all' | 'active' | 'expired' | 'canceled' | 'free'
  // Resultados
  totalTargeted  Int       @default(0)
  totalSent      Int       @default(0)
  status         String    @default("draft") // draft, sending, sent, failed
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  author User @relation("BroadcastAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("broadcasts")
}
